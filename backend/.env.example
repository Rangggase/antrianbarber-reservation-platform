# Salin ke .env lalu isi nilainya. Jangan unggah .env ke GitHub.

# --- PostgreSQL lokal ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=antrian_barber_db
DB_USER=postgres
DB_PASSWORD=ISI_PASSWORD_POSTGRES_LOKAL
# Opsional: DATABASE_URL=postgresql+psycopg://... (jangan gunakan bila memakai DB_* di atas)

# --- Token akses reservasi (WAJIB, minimal 32 karakter) ---
# Tanpa nilai ini, POST /api/v1/bookings mengembalikan 503.
# Buat nilai acak:  python -c "import secrets; print(secrets.token_urlsafe(48))"
BOOKING_TOKEN_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# --- Login staf (WAJIB untuk /api/v1/staff/*, minimal 32 karakter, BEDA dari BOOKING_TOKEN_SECRET) ---
# Tanpa nilai ini login staf mengembalikan 503. Buat nilai acak:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STAFF_JWT_SECRET=GANTI_DENGAN_STRING_ACAK_LAIN_MINIMAL_32_KARAKTER
# Masa berlaku token staf dalam menit (5-1440, default 480).
# STAFF_TOKEN_MINUTES=480
# AB_RL_LOGIN_PER_MINUTE=10     # batas percobaan login per klien per menit
# AB_RL_STAFF_PER_MINUTE=120

# --- Logging (opsional): DEBUG | INFO | WARNING | ERROR ---
# LOG_LEVEL=INFO

# --- Tes integrasi PostgreSQL (opsional) ---
# Nama database khusus tes; HARUS berakhiran _test karena skemanya di-DROP dan dibuat ulang.
# Buat dengan: python -m scripts.create_test_db
# TEST_DB_NAME=antrian_barber_test

# --- CORS (opsional) ---
# Origin frontend yang diizinkan, dipisah koma. Tanpa wildcard dan tanpa path.
# Default: localhost/127.0.0.1 port 5173 dan 4173.
# CORS_ORIGINS=https://app.example.com

# --- Rate limit per menit per klien (opsional, 1-100000) ---
# AB_RL_AVAILABILITY_PER_MINUTE=180
# AB_RL_CREATE_PER_MINUTE=30
# AB_RL_DETAIL_PER_MINUTE=90
# AB_RL_CANCEL_PER_MINUTE=30
