# Salin ke .env.development.local (untuk `npm run dev`) atau set sebagai variabel build.
# Variabel VITE_* ikut terkirim ke browser: JANGAN isi rahasia.

# Satu saklar untuk semua data: demo (localStorage, default) atau api (FastAPI).
VITE_DATA_SOURCE=demo

# Origin backend, tanpa path. Wajib bila memakai api. Build produksi gagal bila kosong/tidak valid.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Opsional: menimpa VITE_DATA_SOURCE per fitur (demo | api).
# VITE_CATALOG_SOURCE=
# VITE_BOOKING_AVAILABILITY_SOURCE=
# VITE_BOOKING_TRANSACTIONS_SOURCE=
